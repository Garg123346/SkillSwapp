# =====================================================================
# SkillSwap Backend Environment Configuration Template (.env.example)
# Copy this file to .env or configure your system environment variables.
# =====================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
# Matches docker compose up -d postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap_db
DB_USER=skillswap
DB_PASSWORD=skillswap

# JWT signing key (generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_A_GENERATED_256_BIT_SECRET
JWT_EXPIRATION_MS=86400000

# Initial Admin Credentials (Configurable for seed)
ADMIN_EMAIL=admin@skillswap.edu
ADMIN_PASSWORD=Admin@123
